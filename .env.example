# --- Supabase (free tier: https://supabase.com) ---
# Leave both blank to use a local SQLite fallback (db/local.db) for dev/testing.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- LLM for resume parsing / tailoring ---
# Free tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Job sources ---
# Free signup at https://developer.adzuna.com — optional, fetcher skips Adzuna if unset.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country code for Adzuna search, e.g. us, gb, in, de
ADZUNA_COUNTRY=us

# --- Search config ---
# Comma-separated keywords used to filter postings across all sources.
JOB_KEYWORDS=machine learning,ml engineer,ai engineer,artificial intelligence,data engineer,mlops,applied scientist,ml scientist

# --- Review queue frontend (frontend/.env, VITE_ prefix required by Vite) ---
# Safe to expose client-side: Supabase Row Level Security (see supabase/schema.sql)
# is what actually restricts access, not secrecy of these values.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
